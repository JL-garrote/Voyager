---
interface Props {
  activeLink?: 'explore' | 'community';
}

const {
  activeLink,
} = Astro.props;
---

<header class="topnav">
  <div class="topnav__left">
    <a href="/" class="topnav__logo">Voyager</a>
  </div>

  <div class="topnav__right">
    <!--
      Un único botón: alterna claro/oscuro. El icono que se ve es el del
      tema al que vas a cambiar (luna en claro, sol en oscuro) y lo
      decide el CSS a partir de data-theme, así no parpadea aunque el JS
      tarde en ejecutarse.
    -->
    <button
      id="theme-toggle"
      type="button"
      class="topnav__icon-btn"
      aria-label="Cambiar tema"
      aria-pressed="false"
    >
      <span class="material-symbols-outlined theme-icon theme-icon--moon">dark_mode</span>
      <span class="material-symbols-outlined theme-icon theme-icon--sun">light_mode</span>
    </button>
  </div>
</header>

<style>
  .topnav {
    position: fixed;
    top: 0;
    width: 100%;
    z-index: 50;
    height: 80px;
    padding-inline: 64px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: color-mix(in srgb, var(--color-background) 75%, transparent);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border-bottom: 1px solid var(--color-outline-variant);
    transition: background-color 0.25s, border-color 0.25s;
  }

  /* ── Left ── */
  .topnav__left {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .topnav__logo {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 48px;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-primary);
    text-decoration: none;
    transition: color 0.25s;
  }

  /* ── Right ── */
  .topnav__right {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .topnav__icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-on-surface-variant);
    transition: color 0.2s, background-color 0.2s;
    border-radius: 0.5rem;
  }

  .topnav__icon-btn:hover {
    color: var(--color-primary);
    background-color: color-mix(in srgb, var(--color-primary) 12%, transparent);
  }

  /* ── Icono del botón de tema ── */
  .theme-icon {
    display: none;
    font-size: 24px;
  }

  /* En claro se ve la luna (destino: oscuro); en oscuro, el sol. */
  :global(html[data-theme='dark']) .theme-icon--sun,
  :global(html:not([data-theme='dark'])) .theme-icon--moon {
    display: block;
  }

  @media (max-width: 480px) {
    .topnav {
      padding-inline: 20px;
    }

    .topnav__logo {
      font-size: 32px;
    }
  }
</style>

<script>
  // ── Tema claro / oscuro ─────────────────────────────────────────────
  // El tema inicial ya lo aplica el script inline de Layout.astro (antes
  // del primer pintado). Aquí solo gestionamos el clic en el botón.
  const STORAGE_THEME_KEY = 'voyager:theme';
  const root = document.documentElement;

  function currentTheme() {
    return root.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
  }

  function syncButton(theme: string, btn: HTMLElement) {
    btn.setAttribute('aria-pressed', String(theme === 'dark'));
    btn.setAttribute(
      'aria-label',
      theme === 'dark' ? 'Cambiar a modo claro' : 'Cambiar a modo oscuro',
    );
  }

  function applyTheme(theme: string, btn: HTMLElement) {
    root.setAttribute('data-theme', theme);
    // color-scheme hace que los controles nativos (scrollbars, selects,
    // inputs de tipo date...) se dibujen también en oscuro.
    root.style.colorScheme = theme;

    try {
      localStorage.setItem(STORAGE_THEME_KEY, theme);
    } catch {
      // localStorage puede fallar en modo privado; el tema sigue aplicándose.
    }

    syncButton(theme, btn);

    // Otros componentes (p. ej. el mapa de Google) escuchan este evento
    // para repintar lo que no se controla con CSS.
    window.dispatchEvent(
      new CustomEvent('voyager:theme-changed', { detail: { theme } }),
    );
  }

  const toggleBtn = document.getElementById('theme-toggle');

  if (toggleBtn) {
    syncButton(currentTheme(), toggleBtn);

    toggleBtn.addEventListener('click', () => {
      applyTheme(currentTheme() === 'dark' ? 'light' : 'dark', toggleBtn);
    });
  }
</script>
