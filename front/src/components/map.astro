  @media (max-width: 480px) {
    .route-search,
    .car-panel {
      width: calc(100% - 32px);
    }

    .map-controls,
    .route-search,
    .car-panel {
      left: 16px;
    }

    .car-panel,
    .route-search {
      right: 16px;
    }

    .map-pill {
      right: 16px;
      padding: 10px 16px;
    }

    .car-panel__row {
      flex-direction: column;
    }

    .marker-card {
      width: calc(100% - 32px);
      flex-direction: column;
    }
  }
</style>

<script define:vars={{ apiKey, geoapifyApiKey, stopsJson, stops }}>

// Km totales de la ruta activa (se actualiza tanto con la ruta de "stops"
// como con la búsqueda manual de origen/destino).
let currentTotalKm = null;

window.addEventListener('voyager:distance-updated', (e) => {
  const value = parseFloat(e.detail.totalKm);
  if (!Number.isNaN(value)) currentTotalKm = value;
});

// ── Tema del mapa ───────────────────────────────────────────────────
// El mapa de Google se pinta en canvas, así que no hereda el CSS: hay
// que darle su propio juego de estilos y volver a aplicarlo cuando el
// usuario cambia de tema con el botón del header.
const MAP_STYLES_LIGHT = [
  { elementType: 'geometry',         stylers: [{ color: '#dff4ff' }] },
  { elementType: 'labels.text.fill', stylers: [{ color: '#3f484b' }] },
  { elementType: 'labels.text.stroke', stylers: [{ color: '#f3faff' }] },
  { elementType: 'labels.icon',      stylers: [{ visibility: 'off' }] },
  { featureType: 'water', elementType: 'geometry', stylers: [{ color: '#bedfef' }] },
  { featureType: 'water', elementType: 'geometry.stroke', stylers: [{ visibility: 'off' }] },
  { featureType: 'road',  elementType: 'geometry', stylers: [{ color: '#ffffff' }] },
  { featureType: 'road',  elementType: 'geometry.stroke', stylers: [{ color: '#c6e8f8' }] },
];

const MAP_STYLES_DARK = [
  { elementType: 'geometry',         stylers: [{ color: '#0b232a' }] },
  { elementType: 'labels.text.fill', stylers: [{ color: '#b7cdd3' }] },
  { elementType: 'labels.text.stroke', stylers: [{ color: '#04141a' }] },
  { elementType: 'labels.icon',      stylers: [{ visibility: 'off' }] },
  { featureType: 'water', elementType: 'geometry', stylers: [{ color: '#04141a' }] },
  { featureType: 'water', elementType: 'geometry.stroke', stylers: [{ visibility: 'off' }] },
  { featureType: 'road',  elementType: 'geometry', stylers: [{ color: '#15343d' }] },
  { featureType: 'road',  elementType: 'geometry.stroke', stylers: [{ color: '#1b3f49' }] },
];

// Elementos que ocultamos siempre, en los dos temas.
const MAP_STYLES_COMMON = [
  { featureType: 'poi',     stylers: [{ visibility: 'off' }] },
  { featureType: 'transit', stylers: [{ visibility: 'off' }] },
  { featureType: 'transit.line',                elementType: 'geometry', stylers: [{ visibility: 'off' }] },
  { featureType: 'administrative',              elementType: 'geometry', stylers: [{ visibility: 'off' }] },
  { featureType: 'administrative.land_parcel',  stylers: [{ visibility: 'off' }] },
  { featureType: 'administrative.neighborhood', stylers: [{ visibility: 'off' }] },
  { featureType: 'administrative.province',     elementType: 'geometry.stroke', stylers: [{ visibility: 'off' }] },
];

function isDarkTheme() {
  return document.documentElement.getAttribute('data-theme') === 'dark';
}

function mapStylesForTheme() {
  return [...(isDarkTheme() ? MAP_STYLES_DARK : MAP_STYLES_LIGHT), ...MAP_STYLES_COMMON];
}

// Lee un token de color del tema activo (definido en global.css) para
// poder usarlo en cosas que se dibujan con JS: pines, rutas, etc.
function themeColor(token, fallback) {
  const value = getComputedStyle(document.documentElement)
    .getPropertyValue(token)
    .trim();
  return value || fallback;
}

function makePinSvg() {
  const fill   = themeColor('--color-primary', '#004451');
  const stroke = themeColor('--color-on-primary', '#ffffff');
  return `data:image/svg+xml;charset=UTF-8,${encodeURIComponent(`
    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 40 40">
      <circle cx="20" cy="20" r="18" fill="${fill}" stroke="${stroke}" stroke-width="3"/>
    </svg>
  `)}`;
}

// Pin en forma de gota con icono de cama, para diferenciar visualmente
// los hoteles de Geoapify de los "stops" del itinerario (que usan un
// círculo simple). Incluye sombra suave para que destaque sobre el mapa.
function makeHotelPinSvg() {
  return `data:image/svg+xml;charset=UTF-8,${encodeURIComponent(`
    <svg xmlns="http://www.w3.org/2000/svg" width="44" height="56" viewBox="0 0 44 56">
      <defs>
        <filter id="pinShadow" x="-50%" y="-50%" width="200%" height="200%">
          <feDropShadow dx="0" dy="2" stdDeviation="2" flood-color="#001f29" flood-opacity="0.35"/>
        </filter>
      </defs>
      <path filter="url(#pinShadow)" d="M22 1C10.4 1 1 10.4 1 22c0 15.5 21 32.5 21 32.5S43 37.5 43 22C43 10.4 33.6 1 22 1z" fill="#8e4e14" stroke="#ffffff" stroke-width="2.5"/>
      <circle cx="22" cy="22" r="14.5" fill="#ffffff"/>
      <g transform="translate(10.5,13)" fill="#8e4e14">
        <path d="M2 3.5A1.5 1.5 0 0 1 3.5 2h5A1.5 1.5 0 0 1 10 3.5V6h3V3.5A1.5 1.5 0 0 1 14.5 2h5A1.5 1.5 0 0 1 21 3.5V10h2v7h-2.2v2h-2V17H4.2v2h-2v-2H0v-7h2V3.5z"/>
        <circle cx="6" cy="5.2" r="1.7" fill="#ffffff"/>
      </g>
    </svg>
  `)}`;
}

// Icono de reemplazo para la tarjeta de información cuando no hay foto
// real del alojamiento (Geoapify no siempre la proporciona). Evita que
// se muestre un <img> roto y mantiene la estética de la app.
function makeHotelPlaceholderImage() {
  return `data:image/svg+xml;charset=UTF-8,${encodeURIComponent(`
    <svg xmlns="http://www.w3.org/2000/svg" width="96" height="96" viewBox="0 0 96 96">
      <rect width="96" height="96" fill="#ffdcc4"/>
      <g transform="translate(20,32)" fill="#8e4e14">
        <path d="M4 8A3 3 0 0 1 7 5h11A3 3 0 0 1 21 8v5h6V8A3 3 0 0 1 30 5h11A3 3 0 0 1 44 8v14h4v14h-4.4v4h-4v-4H8.4v4h-4v-4H0V22h4V8z"/>
        <circle cx="12" cy="11" r="3.4" fill="#ffdcc4"/>
      </g>
    </svg>
  `)}`;
}

// ── Inicializar mapa cuando carga la API ──────────────────────────
window.__initVoyagerMap = function () {
  const parsedStops = JSON.parse(stopsJson);

  const center = parsedStops.length
    ? { lat: parsedStops[0].lat, lng: parsedStops[0].lng }
    : { lat: 48.8566, lng: 2.3522 };

  const map = new google.maps.Map(document.getElementById('gmap'), {
    center,
    zoom: 13,
    disableDefaultUI: true,
    gestureHandling: 'greedy',
    renderingType: google.maps.RenderingType.RASTER,
    styles: mapStylesForTheme(),
  });

  const fixMapSeams = () => {
    google.maps.event.trigger(map, 'resize');
    map.setCenter(map.getCenter());
  };

  let tilesLoadedFixes = 0;
  const MAX_TILE_FIXES = 5;

  google.maps.event.addListener(map, 'tilesloaded', () => {
    if (tilesLoadedFixes >= MAX_TILE_FIXES) return;
    tilesLoadedFixes += 1;
    fixMapSeams();
  });

  [250, 600, 1200].forEach(delay => setTimeout(fixMapSeams, delay));

  const gmapEl = document.getElementById('gmap');
  if (window.ResizeObserver) {
    const resizeObserver = new ResizeObserver(() => fixMapSeams());
    resizeObserver.observe(gmapEl);
  } else {
    window.addEventListener('resize', fixMapSeams);
  }

  function stopIcon() {
    return {
      url: makePinSvg(),
      scaledSize: new google.maps.Size(40, 40),
      anchor: new google.maps.Point(20, 20),
    };
  }

  function stopLabel(idx) {
    return {
      text: String(idx + 1),
      color: themeColor('--color-on-primary', '#ffffff'),
      fontSize: '13px',
      fontWeight: '700',
      fontFamily: 'Inter, sans-serif',
    };
  }

  const markers = parsedStops.map((stop, idx) => {
    const marker = new google.maps.Marker({
      position: { lat: stop.lat, lng: stop.lng },
      map,
      title: stop.label,
      icon: stopIcon(),
      label: stopLabel(idx),
      animation: google.maps.Animation.DROP,
    });

    marker.addListener('click', () => showCard(stop));
    return marker;
  });

  // Al cambiar el tema (botón del header) repintamos lo que no depende
  // del CSS: los estilos del mapa y los pines de las paradas.
  window.addEventListener('voyager:theme-changed', () => {
    map.setOptions({ styles: mapStylesForTheme() });
    markers.forEach((marker, idx) => {
      marker.setIcon(stopIcon());
      marker.setLabel(stopLabel(idx));
    });
  });

  if (parsedStops.length >= 2) {
    const directionsService  = new google.maps.DirectionsService();
    const directionsRenderer = new google.maps.DirectionsRenderer({
      map,
      suppressMarkers: true,
      polylineOptions: {
        strokeColor:   themeColor('--color-primary', '#005d6e'),
        strokeOpacity: 0.7,
        strokeWeight:  4,
      },
    });

    const waypoints = parsedStops.slice(1, -1).map(s => ({
      location: { lat: s.lat, lng: s.lng },
      stopover: true,
    }));

    directionsService.route(
      {
        origin:      { lat: parsedStops[0].lat,                             lng: parsedStops[0].lng },
        destination: { lat: parsedStops[parsedStops.length - 1].lat,        lng: parsedStops[parsedStops.length - 1].lng },
        waypoints,
        travelMode: google.maps.TravelMode.DRIVING,
      },
      (result, status) => {
        if (status === 'OK') {
          directionsRenderer.setDirections(result);

          const legs        = result.routes[0].legs;
          const totalMeters  = legs.reduce((acc, l) => acc + l.distance.value, 0);
          const totalKm      = (totalMeters / 1000).toFixed(1);
          const stopsMetaEl = document.getElementById('stops-meta');
          if (stopsMetaEl) {
            stopsMetaEl.textContent = `${parsedStops.length} Stops • ${totalKm} km total`;
          }

          // Compartimos la distancia con otros componentes (ej. formulario de combustible)
          window.dispatchEvent(
            new CustomEvent('voyager:distance-updated', { detail: { totalKm } })
          );
        }
      },
    );
  }

  function showCard(stop) {
    const card  = document.getElementById('marker-card');
    const img   = document.getElementById('mc-img');
    const title = document.getElementById('mc-title');
    const sub   = document.getElementById('mc-sub');
    const tags  = document.getElementById('mc-tags');
    const dirBtn = document.getElementById('mc-directions');

    title.textContent = stop.label;
    sub.textContent   = stop.time ?? '';
    img.alt           = stop.label;

    // Si no hay imagen (o falla al cargar), ocultamos el <img> para no
    // mostrar el icono de "imagen rota"; el fondo de color del wrapper
    // se ve en su lugar.
    if (stop.image) {
      img.src = stop.image;
      img.style.display = '';
      img.onerror = () => { img.style.display = 'none'; };
    } else {
      img.removeAttribute('src');
      img.style.display = 'none';
    }

    tags.innerHTML = (stop.tags ?? [])
      .map(t => `<span class="marker-card__tag">${t}</span>`)
      .join('');

    dirBtn.onclick = () => {
      window.open(
        `https://www.google.com/maps/dir/?api=1&destination=${stop.lat},${stop.lng}`,
        '_blank',
      );
    };

    card.classList.remove('marker-card--hidden');
  }

  map.addListener('click', () => {
    document.getElementById('marker-card').classList.add('marker-card--hidden');
  });

  document.getElementById('zoom-in').addEventListener('click',  () => map.setZoom(map.getZoom() + 1));
  document.getElementById('zoom-out').addEventListener('click', () => map.setZoom(map.getZoom() - 1));

  document.getElementById('my-location').addEventListener('click', () => {
    navigator.geolocation?.getCurrentPosition(pos => {
      map.panTo({ lat: pos.coords.latitude, lng: pos.coords.longitude });
      map.setZoom(15);
    });
  });

  // ── Hoteles (Geoapify Places API) ────────────────────────────────
  // Muestra/oculta marcadores de alojamiento (hoteles, hostales,
  // apartamentos turísticos, etc.) alrededor del DESTINO del viaje
  // (la última parada del itinerario), no de todo lo que se ve en pantalla.
  let hotelMarkers = [];
  let hotelsVisible = false;
  let hotelsLoading = false;

  const hotelToggleBtn = document.getElementById('hotel-toggle');

  // Punto de referencia dinámico. Empieza con la última parada del
  // itinerario (si existe); se sobreescribe cada vez que se calcula
  // una ruta con el buscador de Origen/Destino, para que "hoteles"
  // siempre apunte al destino que el usuario acaba de buscar.
  const initialDestinationStop = parsedStops.length
    ? parsedStops[parsedStops.length - 1]
    : null;

  let currentDestination = initialDestinationStop
    ? { lat: initialDestinationStop.lat, lng: initialDestinationStop.lng }
    : null;

  function clearHotelMarkers() {
    hotelMarkers.forEach(m => m.setMap(null));
    hotelMarkers = [];
  }

  async function fetchHotels() {
    if (!currentDestination) return [];

    const lat = currentDestination.lat;
    const lon = currentDestination.lng;
    const radius = 5000; // 5 km alrededor del destino

    // "accommodation" es la categoría padre en Geoapify e incluye ya
    // hoteles, hostales, apartamentos turísticos, guest houses, moteles,
    // etc. Antes se pedía una lista separada por comas de subcategorías
    // (accommodation.hotel,accommodation.hostel,...), pero la API de
    // Geoapify la rechaza con 400 "Category ... is not supported" en
    // cuanto hay más de una categoría en la lista (comprobado también
    // con "|" y con categorías duplicadas) — por eso el botón no
    // mostraba nunca ningún hotel.
    const categories = 'accommodation';

    const url = new URL('https://api.geoapify.com/v2/places');
    url.searchParams.set('categories', categories);
    url.searchParams.set('filter', `circle:${lon},${lat},${radius}`);
    url.searchParams.set('bias', `proximity:${lon},${lat}`);
    url.searchParams.set('limit', '50');
    url.searchParams.set('apiKey', geoapifyApiKey);

    const res = await fetch(url);
    if (!res.ok) {
      throw new Error(`Geoapify respondió ${res.status}`);
    }
    const data = await res.json();
    return data.features ?? [];
  }

  function addHotelMarkers(features) {
    clearHotelMarkers();

    hotelMarkers = features
      .filter(f => f.geometry?.coordinates?.length === 2)
      .map(feature => {
        const [lon, lat] = feature.geometry.coordinates;
        const props = feature.properties ?? {};
        const nombre = props.name || 'Alojamiento sin nombre';
        const direccion = props.formatted || props.address_line2 || '';
        const categoriaTags = (props.categories ?? [])
          .filter(c => c.startsWith('accommodation'))
          .map(c => c.split('.').pop());

        const marker = new google.maps.Marker({
          position: { lat, lng: lon },
          map,
          title: nombre,
          icon: {
            url: makeHotelPinSvg(),
            scaledSize: new google.maps.Size(44, 56),
            anchor: new google.maps.Point(22, 56),
          },
          animation: google.maps.Animation.DROP,
        });

        marker.addListener('click', () => {
          showCard({
            label: nombre,
            time: direccion,
            image: makeHotelPlaceholderImage(),
            tags: categoriaTags,
            lat,
            lng: lon,
          });
        });

        return marker;
      });
  }

  async function toggleHotels() {
    if (hotelsLoading) return;

    if (hotelsVisible) {
      clearHotelMarkers();
      hotelsVisible = false;
      hotelToggleBtn.classList.remove('map-zoom--active');
      return;
    }

    if (!currentDestination) {
      routeError.textContent = 'Primero calcula una ruta para ver hoteles del destino.';
      routeError.classList.remove('route-error--hidden');
      routePanel.classList.remove('route-search__panel--hidden');
      routeChevron.classList.add('route-search__chevron--open');
      return;
    }

    hotelsLoading = true;
    hotelToggleBtn.classList.add('map-zoom--active');

    try {
      const features = await fetchHotels();
      addHotelMarkers(features);
      hotelsVisible = true;

      // Centramos el mapa en el destino para que se vean bien los
      // hoteles encontrados, sin perder demasiado zoom.
      map.panTo(currentDestination);
      if (map.getZoom() < 13) map.setZoom(13);

      if (features.length === 0) {
        console.warn('No se encontraron alojamientos cerca del destino.');
      }
    } catch (err) {
      console.error('Error obteniendo hoteles de Geoapify:', err);
      hotelToggleBtn.classList.remove('map-zoom--active');

      routeError.textContent = 'No se pudieron cargar los alojamientos. Inténtalo de nuevo en unos segundos.';
      routeError.classList.remove('route-error--hidden');
      routePanel.classList.remove('route-search__panel--hidden');
      routeChevron.classList.add('route-search__chevron--open');
    } finally {
      hotelsLoading = false;
    }
  }

  hotelToggleBtn.addEventListener('click', toggleHotels);
  // ──────────────────────────────────────────────────────────────────

  const originInput      = document.getElementById('route-origin');
  const destinationInput = document.getElementById('route-destination');

  const originAutocomplete      = new google.maps.places.Autocomplete(originInput);
  const destinationAutocomplete = new google.maps.places.Autocomplete(destinationInput);

  const routePanel   = document.getElementById('route-search-panel');
  const routeToggle  = document.getElementById('route-search-toggle');
  const routeChevron = document.getElementById('route-search-chevron');

  routeToggle.addEventListener('click', () => {
    const isHidden = routePanel.classList.contains('route-search__panel--hidden');
    routePanel.classList.toggle('route-search__panel--hidden');
    routeChevron.classList.toggle('route-search__chevron--open', isHidden);
  });

  const routeSubmit   = document.getElementById('route-search-submit');
  const routeResult   = document.getElementById('route-result');
  const routeError    = document.getElementById('route-error');
  const durationLabel = document.getElementById('route-result-duration');
  const distanceLabel = document.getElementById('route-result-distance');

  const searchDirectionsRenderer = new google.maps.DirectionsRenderer({
    map,
    suppressMarkers: false,
    polylineOptions: {
      strokeColor:   themeColor('--color-secondary', '#8e4e14'),
      strokeOpacity: 0.9,
      strokeWeight:  5,
    },
  });

  routeSubmit.addEventListener('click', () => {
    const origin      = originInput.value.trim();
    const destination  = destinationInput.value.trim();

    routeError.classList.add('route-error--hidden');
    routeResult.classList.add('route-result--hidden');

    if (!origin || !destination) {
      routeError.textContent = 'Introduce origen y destino.';
      routeError.classList.remove('route-error--hidden');
      return;
    }

    const directionsService = new google.maps.DirectionsService();

    directionsService.route(
      {
        origin,
        destination,
        travelMode: google.maps.TravelMode.DRIVING,
      },
      (result, status) => {
        if (status === 'OK') {
          searchDirectionsRenderer.setDirections(result);

          const leg = result.routes[0].legs[0];
          durationLabel.textContent = leg.duration.text;
          distanceLabel.textContent = leg.distance.text;
          routeResult.classList.remove('route-result--hidden');

          // Actualizamos el destino de referencia para el botón de
          // hoteles: usamos la ubicación geocodificada real (end_location)
          // en vez del texto escrito, y limpiamos los hoteles de una
          // búsqueda anterior para que el usuario tenga que volver a
          // pulsar el botón sobre el destino nuevo.
          currentDestination = {
            lat: leg.end_location.lat(),
            lng: leg.end_location.lng(),
          };
          if (hotelsVisible) {
            clearHotelMarkers();
            hotelsVisible = false;
            hotelToggleBtn.classList.remove('map-zoom--active');
          }

          requestAnimationFrame(() => {
            fixMapSeams();
            routeToggle.style.transform = 'translateZ(0.01px)';
            void routeToggle.offsetHeight;
            routeToggle.style.transform = 'translateZ(0)';
          });

          const totalKm = (leg.distance.value / 1000).toFixed(1);

          // Mantenemos currentTotalKm sincronizado con esta ruta también
          window.dispatchEvent(
            new CustomEvent('voyager:distance-updated', { detail: { totalKm } })
          );

          fetch('http://localhost:8080/api/trips/saveTrip', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ totalKm: parseFloat(totalKm) }),
          })
            .then(res => res.json())
            .then(data => console.log('Distancia guardada en backend:', data))
            .catch(err => console.error('Error enviando distancia al backend:', err));
          // ────────────────────────────────────────────────────
        } else {
          routeError.textContent = `No se pudo calcular la ruta (${status}).`;
          routeError.classList.remove('route-error--hidden');
        }
      },
    );
  });

  const carForm     = document.getElementById('car-form');
  const carToggle   = document.getElementById('car-panel-toggle');
  const carChevron  = document.getElementById('car-panel-chevron');

  carToggle.addEventListener('click', () => {
    const isHidden = carForm.classList.contains('car-panel__form--hidden');
    carForm.classList.toggle('car-panel__form--hidden');
    carChevron.classList.toggle('car-panel__chevron--open', isHidden);
  });

  // Convierte a entero de forma segura; si está vacío o no es un número,
  // devuelve 0 en vez de null (los campos int de Coche son primitivos y
  // no admiten null).
  function toInt(value) {
    const parsed = parseInt(value, 10);
    return Number.isNaN(parsed) ? 0 : parsed;
  }

  // Los nombres de estas propiedades deben coincidir EXACTAMENTE con los
  // campos de com.example.demo.Models.Coche para que Jackson los mapee bien.
  function readCarData() {
    return {
      marca:             document.getElementById('car-make').value,
      modelo:            document.getElementById('car-model').value,
      anio:              toInt(document.getElementById('car-year').value),
      version:           document.getElementById('car-trim').value,
      combustible:       document.getElementById('car-fuel-type').value,
      transmision:       document.getElementById('car-transmission').value,
      cilindrada:        toInt(document.getElementById('car-displacement').value),
      potencia:          toInt(document.getElementById('car-power').value),
      peso:              toInt(document.getElementById('car-weight').value),
      numeroOcupantes:   toInt(document.getElementById('car-occupants').value),
      consumoConocido:   toInt(document.getElementById('car-known-consumption').value),
      notasAdicionales:  document.getElementById('car-notes').value,
    };
  }

  const carSaveBtn    = document.getElementById('car-form-save');
  const carSaveStatus = document.getElementById('car-save-status');

  carSaveBtn.addEventListener('click', () => {
    const carData = readCarData();

    window.dispatchEvent(
      new CustomEvent('voyager:car-data-saved', { detail: carData })
    );

    carSaveStatus.classList.remove('car-save-status--hidden', 'car-save-status--error');
    carSaveStatus.textContent = 'Guardando...';

    fetch('http://localhost:8080/api/coche/guardarCoche', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(carData),
    })
      .then(res => {
        if (!res.ok) throw new Error(`Error ${res.status}`);
        return res.json();
      })
      .then(data => {
        console.log('Coche guardado en backend:', data);
        carSaveStatus.textContent = 'Datos del coche guardados correctamente.';
      })
      .catch(err => {
        console.error('Error guardando el coche:', err);
        carSaveStatus.textContent = 'No se pudo guardar el coche.';
        carSaveStatus.classList.add('car-save-status--error');
      });
  });

  const carEstimateBtn = document.getElementById('car-estimate-btn');
  const aiModalOverlay = document.getElementById('ai-modal-overlay');
  const aiModalClose   = document.getElementById('ai-modal-close');
  const aiModalLoading = document.getElementById('ai-modal-loading');
  const aiModalContent = document.getElementById('ai-modal-content');
  const aiModalError   = document.getElementById('ai-modal-error');

  // Movemos el overlay del modal directamente a <body>. Así evitamos que
  // quede recortado o mal posicionado si algún contenedor padre del
  // widget (fuera de este componente) tiene overflow:hidden o transform,
  // lo cual rompería el position:fixed y ocultaría el popup.
  document.body.appendChild(aiModalOverlay);

  // Convierte el texto plano de Gemini (que puede traer **negritas** y
  // saltos de línea) en HTML simple y legible dentro del popup.
  function formatAiText(text) {
    return text
      .trim()
      .split(/\n\s*\n/) // separa en párrafos por líneas en blanco
      .map(paragraph => {
        const withBold = paragraph
          .trim()
          .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
          .replace(/\n/g, '<br>');
        return `<p>${withBold}</p>`;
      })
      .join('');
  }

  function openAiModal() {
    aiModalOverlay.classList.remove('ai-modal-overlay--hidden');
  }

  function closeAiModal() {
    aiModalOverlay.classList.add('ai-modal-overlay--hidden');
  }

  aiModalClose.addEventListener('click', closeAiModal);
  aiModalOverlay.addEventListener('click', (e) => {
    if (e.target === aiModalOverlay) closeAiModal();
  });

  carEstimateBtn.addEventListener('click', () => {
    if (currentTotalKm === null) {
      aiModalContent.innerHTML = '';
      aiModalError.textContent = 'Primero calcula una ruta para tener los km totales.';
      aiModalError.classList.remove('route-error--hidden');
      aiModalLoading.classList.add('ai-modal__loading--hidden');
      openAiModal();
      return;
    }

    aiModalError.classList.add('route-error--hidden');
    aiModalContent.innerHTML = '';
    aiModalLoading.classList.remove('ai-modal__loading--hidden');
    openAiModal();

    // El backend usa el último coche y el último viaje guardados
    // internamente (no hace falta enviar body). Al ser GET, fetch no
    // admite 'body' en la petición.
    fetch('http://localhost:8080/api/coche/respuestaIA', {
      method: 'GET',
      headers: { 'Content-Type': 'application/json' },
    })
      .then(res => {
        if (!res.ok) throw new Error(`Error ${res.status}`);
        return res.text(); // el backend devuelve un String (respuesta de Gemini), no JSON
      })
      .then(text => {
        aiModalLoading.classList.add('ai-modal__loading--hidden');
        aiModalContent.innerHTML = formatAiText(text);
      })
      .catch(err => {
        console.error('Error estimando consumo:', err);
        aiModalLoading.classList.add('ai-modal__loading--hidden');
        aiModalError.textContent = 'No se pudo calcular el consumo.';
        aiModalError.classList.remove('route-error--hidden');
      });
  });
};

(function loadGoogleMaps() {
  if (window.google?.maps) { window.__initVoyagerMap(); return; }
  const script   = document.createElement('script');
  script.src     = `https://maps.googleapis.com/maps/api/js?key=${apiKey}&callback=__initVoyagerMap&libraries=places`;
  script.async   = true;
  script.defer   = true;
  document.head.appendChild(script);
})();
</script>