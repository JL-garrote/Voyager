---
interface Stop {
  id: string;
  label: string;
  lat: number;
  lng: number;
  icon: 'flight' | 'hotel' | 'restaurant' | 'tour' | 'default';
  time?: string;
}

interface Props {
  apiKey?: string;
  geoapifyApiKey?: string;
  stops?: Stop[];
  dayLabel?: string;
  totalDistance?: string;
}

const {
  apiKey = import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY,
  geoapifyApiKey = import.meta.env.PUBLIC_GEOAPIFY_API_KEY,
  stops = [],
} = Astro.props;

if (!apiKey) {
  throw new Error(
    'Falta la API key de Google Maps. Define PUBLIC_GOOGLE_MAPS_API_KEY en tu archivo .env',
  );
}

if (!geoapifyApiKey) {
  throw new Error(
    'Falta la API key de Geoapify. Define PUBLIC_GEOAPIFY_API_KEY en tu archivo .env',
  );
}

const stopsJson = JSON.stringify(stops);
---
<div class="map-root">


  <div class="map-controls">
    <div class="map-zoom">
      <button id="zoom-in"  class="map-zoom__btn" aria-label="Zoom in">
        <span class="material-symbols-outlined">add</span>
      </button>
      <hr class="map-zoom__divider" />
      <button id="zoom-out" class="map-zoom__btn" aria-label="Zoom out">
        <span class="material-symbols-outlined">remove</span>
      </button>
    </div>
    <button id="my-location" class="map-zoom map-zoom--icon" aria-label="My location">
      <span class="material-symbols-outlined">my_location</span>
    </button>
    <button id="hotel-toggle" class="map-zoom map-zoom--icon" aria-label="Mostrar hoteles">
      <span class="material-symbols-outlined">hotel</span>
    </button>
  </div>

  <div class="route-search">
    <button id="route-search-toggle" class="route-search__toggle" aria-label="Buscar ruta">
      <span class="material-symbols-outlined">route</span>
      <span>Buscar ruta</span>
      <span class="material-symbols-outlined route-search__chevron" id="route-search-chevron">expand_more</span>
    </button>

    <div id="route-search-panel" class="route-search__panel route-search__panel--hidden">
      <label class="route-search__label">
        Origen
        <input id="route-origin" type="text" placeholder="Punto de partida" class="route-search__input" />
      </label>
      <label class="route-search__label">
        Destino
        <input id="route-destination" type="text" placeholder="Punto de llegada" class="route-search__input" />
      </label>
      <button id="route-search-submit" class="route-search__submit">Calcular ruta</button>

      <div id="route-result" class="route-result route-result--hidden">
        <div class="route-result__row">
          <span class="material-symbols-outlined">schedule</span>
          <span id="route-result-duration">—</span>
        </div>
        <div class="route-result__row">
          <span class="material-symbols-outlined">social_distance</span>
          <span id="route-result-distance">—</span>
        </div>
      </div>
      <p id="route-error" class="route-error route-error--hidden"></p>
    </div>
  </div>

  <div class="car-panel">
    <button id="car-panel-toggle" class="car-panel__toggle" aria-label="Datos del coche">
      <span class="material-symbols-outlined">directions_car</span>
      <span>Datos del coche</span>
      <span class="material-symbols-outlined car-panel__chevron" id="car-panel-chevron">expand_more</span>
    </button>

    <form id="car-form" class="car-panel__form car-panel__form--hidden">
      <div class="car-panel__row">
        <label class="car-panel__label">
          Marca
          <input type="text" id="car-make" placeholder="Seat" />
        </label>
        <label class="car-panel__label">
          Modelo
          <input type="text" id="car-model" placeholder="León" />
        </label>
      </div>

      <div class="car-panel__row">
        <label class="car-panel__label">
          Año
          <input type="text" id="car-year" placeholder="2019" />
        </label>
        <label class="car-panel__label">
          Versión / acabado
          <input type="text" id="car-trim" placeholder="FR 1.5 TSI" />
        </label>
      </div>

      <div class="car-panel__row">
        <label class="car-panel__label">
          Tipo de combustible
          <select id="car-fuel-type">
            <option value="gasolina">Gasolina</option>
            <option value="diesel">Diésel</option>
            <option value="hibrido">Híbrido</option>
            <option value="hibrido-enchufable">Híbrido enchufable</option>
            <option value="electrico">Eléctrico</option>
            <option value="glp">GLP / Autogas</option>
          </select>
        </label>
        <label class="car-panel__label">
          Transmisión
          <select id="car-transmission">
            <option value="manual">Manual</option>
            <option value="automatica">Automática</option>
          </select>
        </label>
      </div>

      <div class="car-panel__row">
        <label class="car-panel__label">
          Cilindrada (cc)
          <input type="number" id="car-displacement" placeholder="1498" />
        </label>
        <label class="car-panel__label">
          Potencia (CV)
          <input type="number" id="car-power" placeholder="150" />
        </label>
      </div>

      <div class="car-panel__row">
        <label class="car-panel__label">
          Peso (kg)
          <input type="number" id="car-weight" placeholder="1320" />
        </label>
        <label class="car-panel__label">
          Nº de ocupantes habitual
          <input type="number" id="car-occupants" placeholder="2" min="1" max="9" />
        </label>
      </div>

      <label class="car-panel__label">
        Consumo conocido (L/100km, opcional)
        <input type="number" id="car-known-consumption" placeholder="Déjalo vacío si no lo sabes" step="0.1" />
      </label>

      <label class="car-panel__label">
        Notas adicionales (carga, portaequipajes, remolque, etc.)
        <textarea id="car-notes" rows="2" placeholder="Ej: con baca puesta, maletero cargado..."></textarea>
      </label>

      <button type="button" id="car-form-save" class="car-panel__submit">
        Guardar datos del coche
      </button>

      <button type="button" id="car-estimate-btn" class="car-panel__submit car-panel__submit--secondary">
        Estimar consumo
      </button>

      <p id="car-save-status" class="car-save-status car-save-status--hidden"></p>
    </form>
  </div>

  <div id="gmap" class="map-canvas"></div>

  <div id="marker-card" class="marker-card marker-card--hidden">
    <div class="marker-card__img-wrap">
      <img id="mc-img" src="" alt="" class="marker-card__img" />
    </div>
    <div class="marker-card__body">
      <div class="marker-card__top">
        <div>
          <h5 id="mc-title" class="marker-card__title"></h5>
          <p  id="mc-sub"   class="marker-card__sub"></p>
        </div>
        <button id="mc-directions" class="marker-card__dir-btn" aria-label="Get directions">
          <span class="material-symbols-outlined">directions</span>
        </button>
      </div>
      <div id="mc-tags" class="marker-card__tags"></div>
    </div>
  </div>
  <div id="ai-modal-overlay" class="ai-modal-overlay ai-modal-overlay--hidden">
    <div class="ai-modal">
      <div class="ai-modal__header">
        <span class="material-symbols-outlined ai-modal__icon">local_gas_station</span>
        <h4 class="ai-modal__title">Estimación de consumo</h4>
        <button id="ai-modal-close" class="ai-modal__close" aria-label="Cerrar">
          <span class="material-symbols-outlined">close</span>
        </button>
      </div>
      <div id="ai-modal-body" class="ai-modal__body">
        <div id="ai-modal-loading" class="ai-modal__loading ai-modal__loading--hidden">
          <span class="material-symbols-outlined ai-modal__spinner">progress_activity</span>
          <p>Calculando estimación...</p>
        </div>
        <div id="ai-modal-content" class="ai-modal__content"></div>
        <p id="ai-modal-error" class="route-error route-error--hidden"></p>
      </div>
    </div>
  </div>

</div>

<!-- ─── Estilos ──────────────────────────────────────────────────── -->
<style>

  .map-root, .map-root * {
    box-sizing: border-box;
  }

  .map-root {
    position: relative;
    width: 100%;
    height: 100%;
    background-color: var(--color-surface-dim);
    overflow: hidden;
  }

  /* Canvas */
  .map-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transform: translateZ(0);
    will-change: transform;
  }

  /* Controles zoom */
  .map-controls {
    position: absolute;
    top: 24px;
    left: 24px;
    z-index: 10;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .map-zoom {
    background: color-mix(in srgb, var(--color-surface-container-lowest) 90%, transparent);
    backdrop-filter: blur(8px);
    transform: translateZ(0);
    will-change: transform;
    border: 1px solid color-mix(in srgb, var(--color-outline-variant) 55%, transparent);
    border-radius: 12px;
    padding: 8px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
  }

  .map-zoom--icon {
    flex-direction: row;
    justify-content: center;
    padding: 12px;
  }

  .map-zoom--active {
    background-color: var(--color-primary);
  }

  .map-zoom--active .map-zoom__btn,
  .map-zoom--active .material-symbols-outlined {
    color: var(--color-on-primary);
  }

  .map-zoom__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px;
    background: none;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    color: var(--color-primary);
    transition: background-color 0.2s;
  }

  .map-zoom__btn:hover { background-color: var(--color-surface-container-high); }

  .map-zoom__divider {
    border: none;
    border-top: 1px solid var(--color-outline-variant);
    margin: 0;
  }

  .map-pill {
    position: absolute;
    top: 24px;
    right: 24px;
    z-index: 10;
    background: color-mix(in srgb, var(--color-surface-container-lowest) 90%, transparent);
    backdrop-filter: blur(8px);
    transform: translateZ(0);
    will-change: transform;
    border: 1px solid color-mix(in srgb, var(--color-outline-variant) 55%, transparent);
    border-radius: 9999px;
    padding: 12px 24px;
    display: flex;
    align-items: center;
    gap: 16px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    max-width: calc(100% - 48px);
  }

  .map-pill__day  { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
  .map-pill__dot  { width: 12px; height: 12px; border-radius: 50%; background-color: var(--color-primary); flex-shrink: 0; }

  .map-pill__label {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 700;
    color: var(--color-on-surface);
    white-space: nowrap;
  }

  .map-pill__divider {
    width: 1px;
    height: 16px;
    background-color: var(--color-outline-variant);
    flex-shrink: 0;
  }

  .map-pill__meta {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-on-surface-variant);
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .route-search {
    position: absolute;
    top: 24px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 15;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    width: 320px;
    max-width: calc(100% - 48px);
  }

  .route-search__toggle {
    display: flex;
    align-items: center;
    gap: 8px;
    background: color-mix(in srgb, var(--color-surface-container-lowest) 90%, transparent);
    backdrop-filter: blur(8px);
    transform: translateZ(0);
    border: 1px solid color-mix(in srgb, var(--color-outline-variant) 55%, transparent);
    border-radius: 9999px;
    padding: 10px 16px;
    cursor: pointer;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 600;
    color: var(--color-primary);
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    width: 100%;
  }

  .route-search__toggle span:nth-child(2) { flex: 1; text-align: left; }

  .route-search__chevron { transition: transform 0.2s; flex-shrink: 0; }
  .route-search__chevron--open { transform: rotate(180deg); }

  .route-search__panel {
    margin-top: 8px;
    background: color-mix(in srgb, var(--color-surface-container-lowest) 95%, transparent);
    backdrop-filter: blur(8px);
    transform: translateZ(0);
    border: 1px solid color-mix(in srgb, var(--color-outline-variant) 55%, transparent);
    border-radius: 16px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    box-shadow: 0 4px 16px rgba(0,0,0,0.1);
    width: 100%;
  }

  .route-search__panel--hidden { display: none; }

  .route-search__label {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 600;
    color: var(--color-on-surface-variant);
    width: 100%;
  }

  .route-search__input {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    padding: 8px 10px;
    border: 1px solid var(--color-outline-variant);
    background-color: var(--color-surface-container-lowest);
    border-radius: 8px;
    color: var(--color-on-surface);
    width: 100%;
    appearance: none;
    -webkit-appearance: none;
  }

  /*
    El autocompletado de direcciones de Chrome/Brave pinta su propio
    fondo/color sobre el input (normalmente pensado para temas claros),
    lo que en modo oscuro deja el campo prácticamente en blanco con solo
    una línea visible. Forzamos aquí nuestros propios colores por encima
    del autofill.
  */
  .route-search__input:-webkit-autofill,
  .route-search__input:-webkit-autofill:hover,
  .route-search__input:-webkit-autofill:focus {
    -webkit-text-fill-color: var(--color-on-surface);
    -webkit-box-shadow: 0 0 0 1000px var(--color-surface-container-lowest) inset;
    box-shadow: 0 0 0 1000px var(--color-surface-container-lowest) inset;
    caret-color: var(--color-on-surface);
    transition: background-color 9999s ease-in-out 0s;
  }

  .route-search__submit {
    margin-top: 4px;
    padding: 10px;
    background-color: var(--color-primary);
    color: var(--color-on-primary);
    border: none;
    border-radius: 9999px;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    width: 100%;
  }
  .route-search__submit:hover { opacity: 0.88; }

  .route-result {
    margin-top: 4px;
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }
  .route-result--hidden { display: none; }
  .route-result__row {
    display: flex;
    align-items: center;
    gap: 4px;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 700;
    color: var(--color-primary);
  }

  .route-error {
    color: var(--color-error);
    font-size: 12px;
    margin: 0;
  }
  .route-error--hidden { display: none; }

  .ai-modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 31, 41, 0.45);
    backdrop-filter: blur(4px);
    padding: 24px;
    transition: opacity 0.2s;
  }

  .ai-modal-overlay--hidden {
    opacity: 0;
    pointer-events: none;
  }

  .ai-modal {
    width: 480px;
    max-width: 100%;
    max-height: calc(100vh - 48px);
    background: var(--color-surface-container-low);
    border-radius: 20px;
    box-shadow: 0 12px 40px rgba(0, 31, 41, 0.25);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .ai-modal__header {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 20px 20px 16px;
    border-bottom: 1px solid var(--color-outline-variant);
    flex-shrink: 0;
  }

  .ai-modal__icon {
    color: var(--color-primary);
  }

  .ai-modal__title {
    flex: 1;
    margin: 0;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 18px;
    font-weight: 700;
    color: var(--color-primary);
  }

  .ai-modal__close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: none;
    background: color-mix(in srgb, var(--color-primary) 10%, transparent);
    color: var(--color-primary);
    cursor: pointer;
    transition: background-color 0.2s;
    flex-shrink: 0;
  }
  .ai-modal__close:hover {
    background-color: color-mix(in srgb, var(--color-primary) 22%, transparent);
  }

  .ai-modal__body {
    padding: 20px;
    overflow-y: auto;
  }

  .ai-modal__loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 24px 0;
    color: var(--color-on-surface-variant);
    font-family: 'Inter', sans-serif;
    font-size: 14px;
  }
  .ai-modal__loading--hidden { display: none; }

  .ai-modal__spinner {
    animation: ai-modal-spin 1s linear infinite;
    color: var(--color-primary);
    font-size: 28px;
  }

  @keyframes ai-modal-spin {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }

  .ai-modal__content {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-on-surface);
  }

  .ai-modal__content p {
    margin: 0 0 12px;
  }
  .ai-modal__content p:last-child {
    margin-bottom: 0;
  }

  .ai-modal__content strong {
    color: var(--color-primary);
  }

  .car-save-status {
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 600;
    color: var(--color-success);
    margin: 0;
  }
  .car-save-status--hidden { display: none; }
  .car-save-status--error { color: var(--color-error); }

  .car-panel {
    position: absolute;
    bottom: 24px;
    left: 24px;
    z-index: 15;
    width: 320px;
    /* Nunca más ancho que el viewport disponible del mapa */
    max-width: calc(100% - 48px);
    max-height: calc(100% - 48px);
    display: flex;
    flex-direction: column;
  }

  .car-panel__toggle {
    display: flex;
    align-items: center;
    gap: 8px;
    background: color-mix(in srgb, var(--color-surface-container-lowest) 90%, transparent);
    backdrop-filter: blur(8px);
    transform: translateZ(0);
    will-change: transform;
    border: 1px solid color-mix(in srgb, var(--color-outline-variant) 55%, transparent);
    border-radius: 9999px;
    padding: 10px 16px;
    cursor: pointer;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 600;
    color: var(--color-primary);
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    width: 100%;
    flex-shrink: 0;
  }

  .car-panel__toggle span:nth-child(2) { flex: 1; text-align: left; }

  .car-panel__chevron { transition: transform 0.2s; flex-shrink: 0; }
  .car-panel__chevron--open { transform: rotate(180deg); }

  .car-panel__form {
    margin-top: 8px;
    background: color-mix(in srgb, var(--color-surface-container-lowest) 95%, transparent);
    backdrop-filter: blur(8px);
    transform: translateZ(0);
    will-change: transform;
    border: 1px solid color-mix(in srgb, var(--color-outline-variant) 55%, transparent);
    border-radius: 16px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    overflow-y: auto;
    overflow-x: hidden;
    box-shadow: 0 4px 16px rgba(0,0,0,0.1);
    width: 100%;
    min-height: 0;
  }

  .car-panel__form--hidden { display: none; }

  .car-panel__row {
    display: flex;
    gap: 10px;
    width: 100%;
  }

  .car-panel__row .car-panel__label {
    flex: 1 1 0;
    min-width: 0;
  }

  .car-panel__label {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 600;
    color: var(--color-on-surface-variant);
    width: 100%;
    min-width: 0;
  }

  .car-panel__label input,
  .car-panel__label select,
  .car-panel__label textarea {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 400;
    color: var(--color-on-surface);
    padding: 8px 10px;
    border: 1px solid var(--color-outline-variant);
    background-color: var(--color-surface-container-lowest);
    border-radius: 8px;
    resize: vertical;
    width: 100%;
    min-width: 0;
  }

  /*
    Solo en input/textarea: quitamos el "appearance" nativo para que no
    compita con nuestros colores. El <select> se deja con su apariencia
    nativa a propósito, para no perder la flechita del desplegable.
  */
  .car-panel__label input,
  .car-panel__label textarea {
    appearance: none;
    -webkit-appearance: none;
  }

  /* Mismo problema de autofill que en .route-search__input (marca, modelo...). */
  .car-panel__label input:-webkit-autofill,
  .car-panel__label input:-webkit-autofill:hover,
  .car-panel__label input:-webkit-autofill:focus {
    -webkit-text-fill-color: var(--color-on-surface);
    -webkit-box-shadow: 0 0 0 1000px var(--color-surface-container-lowest) inset;
    box-shadow: 0 0 0 1000px var(--color-surface-container-lowest) inset;
    caret-color: var(--color-on-surface);
    transition: background-color 9999s ease-in-out 0s;
  }

  .car-panel__label select {
    max-width: 100%;
  }

  .car-panel__submit {
    margin-top: 4px;
    padding: 10px;
    background-color: var(--color-primary);
    color: var(--color-on-primary);
    border: none;
    border-radius: 9999px;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    width: 100%;
    flex-shrink: 0;
  }
  .car-panel__submit:hover { opacity: 0.88; }

  .car-panel__submit--secondary {
    background-color: transparent;
    color: var(--color-primary);
    border: 1px solid var(--color-primary);
  }
