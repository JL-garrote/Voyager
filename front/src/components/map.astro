    color: var(--color-primary);
    margin: 0 0 4px;
  }

  .marker-card__sub {
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 600;
    color: var(--color-on-surface-variant);
    display: flex;
    align-items: center;
