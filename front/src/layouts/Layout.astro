---
import TopNav from '../components/Header.astro';
import Map from '../components/map.astro';
import '../styles/global.css';

interface Props {
  title?: string;
}

const {
  title = 'Voyager',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <!--
      Tema: se aplica ANTES de pintar nada para evitar el parpadeo blanco
      al recargar en modo oscuro. Va inline (is:inline) a propósito: los
      <script> normales de Astro se cargan como módulos diferidos y se
      ejecutarían demasiado tarde.
      Prioridad: elección guardada > preferencia del sistema.
    -->
    <script is:inline>
      (function () {
        var stored = null;
        try {
          stored = localStorage.getItem('voyager:theme');
        } catch (e) {}

        var theme =
          stored === 'dark' || stored === 'light'
            ? stored
            : window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';

        document.documentElement.setAttribute('data-theme', theme);
        document.documentElement.style.colorScheme = theme;
      })();
    </script>

    <!-- Fuentes -->
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="font-body-md text-body-md">
    <TopNav/>
    <main class="pt-20 h-screen flex overflow-hidden">
      
      <Map />


    </main>
  </body>
</html>